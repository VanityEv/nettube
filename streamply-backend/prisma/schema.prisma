// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SECURITY: Prisma ORM models to replace all raw SQL queries
// This prevents SQL injection attacks through parameterized queries

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  fullname           String?
  password           String
  email              String    @unique
  birthdate          DateTime?
  confirmed          Boolean   @default(false)
  register_token     String?   @map("register_token")
  register_date      DateTime  @default(now()) @map("register_date")
  last_login         DateTime? @map("last_login")
  account_type       Int       @default(1) @map("account_type")
  stripe_customer_id String?   @map("stripe_customer_id")
  avatar_url         String?   @map("avatar_url") // B2 cloud storage URL for user avatar
  created_at         DateTime  @default(now()) @map("created_at")

  // Relations
  reviews        Review[]
  userLikes      UserLike[]      @relation("UserLikes")
  userWatching   UserWatching[]  @relation("UserWatching")
  trustedDevices TrustedDevice[] @relation("UserTrustedDevices")
  refreshTokens  RefreshToken[]  @relation("UserRefreshTokens")
  subscription   Subscription?   @relation("UserSubscription")

  @@map("users")
}

model Video {
  id                  String   @id @default(uuid()) @db.Uuid
  title               String
  type                String // 'film' or 'series'
  genre               String?
  production_year     Int?     @map("production_year")
  production_country  String?  @map("production_country")
  director            String?
  tags                String?
  descr               String?
  thumbnail           String?
  cinematic_thumbnail String?  @map("cinematic_thumbnail") // B2 cloud storage URL for 16:9 cinematic thumbnail
  video_url           String?  @map("video_url") // B2 cloud storage URL for video file
  thumbnail_url       String?  @map("thumbnail_url") // B2 cloud storage URL for thumbnail
  grade               Decimal? @db.Decimal(3, 1)
  reviews_count       Int      @default(0) @map("reviews_count")
  views               Int      @default(0)
  link                String?
  blocked_reviews     Boolean  @default(false) @map("blocked_reviews")
  created_at          DateTime @default(now()) @map("created_at")

  // Relations
  reviews        Review[]
  userLikes      UserLike[]      @relation("VideoLikes")
  seriesEpisodes SeriesEpisode[]
  userWatching   UserWatching[]  @relation("VideoWatching")

  @@map("videos")
}

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @map("user_id") @db.Uuid
  video_id     String   @map("video_id") @db.Uuid
  comment      String?
  grade        Decimal? @db.Decimal(3, 1)
  comment_date DateTime @default(now()) @map("comment_date")

  // Relations
  user  User  @relation(fields: [user_id], references: [id])
  video Video @relation(fields: [video_id], references: [id])

  @@map("reviews")
}

model UserLike {
  id       String @id @default(uuid()) @db.Uuid
  user_id  String @map("user_id") @db.Uuid
  video_id String @map("video_id") @db.Uuid

  // Relations
  user  User  @relation("UserLikes", fields: [user_id], references: [id])
  video Video @relation("VideoLikes", fields: [video_id], references: [id])

  @@unique([user_id, video_id])
  @@map("user_likes")
}

model SeriesEpisode {
  id                  String  @id @default(uuid()) @db.Uuid
  show_id             String  @map("show_id") @db.Uuid
  season              Int
  episode             Int
  episode_name        String? @map("episode_name")
  description         String?
  video_url           String? @map("video_url") // B2 cloud storage URL for episode video
  thumbnail_url       String? @map("thumbnail_url") // B2 cloud storage URL for episode thumbnail
  cinematic_thumbnail String? @map("cinematic_thumbnail") // B2 cloud storage URL for 16:9 cinematic thumbnail

  // Relations
  show Video @relation(fields: [show_id], references: [id])

  @@map("series_episodes")
}

model UserWatching {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @map("user_id") @db.Uuid
  show_id      String   @map("show_id") @db.Uuid
  time_watched Int      @map("time_watched") // Progress in seconds
  season       Int? // For series - which season
  episode      Int? // For series - which episode
  updated_at   DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user  User  @relation("UserWatching", fields: [user_id], references: [id])
  video Video @relation("VideoWatching", fields: [show_id], references: [id])

  @@unique([user_id, show_id])
  @@map("user_watching")
}

model TrustedDevice {
  id                 String   @id @default(uuid()) @db.Uuid
  user_id            String   @map("user_id") @db.Uuid
  device_fingerprint String   @map("device_fingerprint")
  device_name        String   @map("device_name") // e.g., "Chrome on Windows"
  device_type        String   @map("device_type") // e.g., "desktop", "mobile", "tablet"
  browser_name       String?  @map("browser_name") // e.g., "Chrome", "Firefox"
  os_name            String?  @map("os_name") // e.g., "Windows", "macOS", "Android"
  last_used          DateTime @default(now()) @map("last_used")
  first_seen         DateTime @default(now()) @map("first_seen")
  last_ip            String?  @map("last_ip")
  last_location      String?  @map("last_location") // City, Country
  is_active          Boolean  @default(true) @map("is_active")

  // Relations
  user User @relation("UserTrustedDevices", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, device_fingerprint])
  @@map("trusted_devices")
}

model RefreshToken {
  id                 String    @id @default(uuid()) @db.Uuid
  user_id            String    @db.Uuid
  token_hash         String
  jti                String    @unique
  device_fingerprint String?
  user_agent         String?
  ip_address         String?
  expires_at         DateTime
  revoked_at         DateTime?
  replaced_by        String?
  created_at         DateTime  @default(now())
  user               User      @relation("UserRefreshTokens", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_tokens")
}

// Subscription model for Stripe integration
model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  user_id              String    @unique @db.Uuid
  stripe_subscription_id String?  @unique @map("stripe_subscription_id")
  stripe_customer_id   String   @map("stripe_customer_id")
  status               String   // active, canceled, past_due, etc.
  current_period_start DateTime @map("current_period_start")
  current_period_end   DateTime @map("current_period_end")
  cancel_at_period_end Boolean  @default(false) @map("cancel_at_period_end")
  created_at           DateTime @default(now()) @map("created_at")
  updated_at           DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation("UserSubscription", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([stripe_subscription_id])
  @@map("subscriptions")
}
