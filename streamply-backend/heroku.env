# =============================================================================
# HEROKU PRODUCTION ENVIRONMENT VARIABLES
# Copy these to your Heroku Config Vars via CLI or Dashboard
# =============================================================================

# DATABASE (Automatically provided by Heroku PostgreSQL addon)
# DATABASE_URL will be automatically set by Heroku

# SECURITY
JWT_SECRET=your-production-jwt-secret-256-bits-minimum
BCRYPT_ROUNDS=12

# PAYMENTS
STRIPE_SECRET_KEY=sk_live_your_production_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_production_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret

# EMAIL
SENDGRID_API_KEY=SG.your_production_sendgrid_api_key
FROM_EMAIL=noreply@yourdomain.com

# STORAGE
B2_KEY_ID=your_production_b2_key_id
B2_APPLICATION_KEY=your_production_b2_application_key
B2_BUCKET_NAME=streamply-videos-prod
B2_BUCKET_ID=your_production_bucket_id

# FRONTEND
FRONTEND_URL=https://your-streamply-app.vercel.app
CORS_ORIGIN=https://your-streamply-app.vercel.app

# LOGGING
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/streamply_logs_prod?retryWrites=true&w=majority

# ENVIRONMENT
NODE_ENV=production
