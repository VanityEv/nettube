# =============================================================================
# STREAMPLY FRONTEND ENVIRONMENT VARIABLES
# For Railway Docker Deployment
# =============================================================================

# PROXY CONFIGURATION
# Use full Railway proxy URL for static site deployment
REACT_APP_USE_PROXY=false
REACT_APP_BASE_URL=https://streamply-proxy-production.up.railway.app
REACT_APP_API_URL=https://streamply-proxy-production.up.railway.app/api

# BACKEND API (for non-proxy environments - Railway backup) 
# REACT_APP_BACKEND_URL=https://streamply-backend-production.up.railway.app
# REACT_APP_API_URL=https://streamply-backend-production.up.railway.app

# STRIPE CONFIGURATION
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# ENVIRONMENT
REACT_APP_NODE_ENV=production

# DEVELOPMENT SETTINGS
GENERATE_SOURCEMAP=false
REACT_APP_DEBUG=false

# SECURITY HEADERS (handled by nginx)
REACT_APP_SECURE_HEADERS=true
